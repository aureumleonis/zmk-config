#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT_LAYER 0
#define FN_L 1
#define HW_L 2
#define MOUSE_TP 3


#define NAV_R_UP_H RGUI
#define NAV_R_UP_T PG_UP
#define NAV_R_DN_H RCTRL
#define NAV_R_DN_T PG_DN
#define NAV_R_LE_H RALT
#define NAV_R_LE_T HOME
#define NAV_R_RI_H RSHFT
#define NAV_R_RI_T END

&lt {
    tapping_term_ms = <150>;
    quick_tap_ms = <300>;
    flavor = "tap-preferred";
};

&mt {
    flavor = "tap-preferred";
};

/ {
    // conditional_layers {
    //     compatible = "zmk,conditional-layers";
    //     tri_layer {
    //         if-layers = <2 3>;
    //         then-layer = <4>;
    //     };
    // };

    // behaviors {
    //     th_liftl: th_liftl_taphold {
    //         compatible = "zmk,behavior-hold-tap";
    //         label = "LIFT_MOD_L";
    //         #binding-cells = <2>;
    //         tapping_term_ms = <300>;
    //         flavor = "hold-preferred";
    //         bindings = <&mod_liftl>, <&kp>;
    //         quick_tap_ms = <500>;
    //     };

    //     th_liftr: th_liftr_taphold {
    //         compatible = "zmk,behavior-hold-tap";
    //         label = "LIFT_MOD_R";
    //         #binding-cells = <2>;
    //         tapping_term_ms = <300>;
    //         flavor = "hold-preferred";
    //         bindings = <&mod_liftr>, <&kp>;
    //         quick_tap_ms = <500>;
    //     };
    // };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp GRAVE  &kp N1      &kp N2      &kp N3         &kp N4     &kp N5     &kp LBKT               &kp RBKT   &kp N6    &kp N7     &kp N8         &kp N9    &kp N0     &kp MINUS
    &kp TAB    &kp Q       &kp W       &kp E          &kp R      &kp T      &kp LEFT               &kp END    &kp Y     &kp U      &kp I          &kp O     &kp P      &kp BSLH
    &kp ESC    &kp A       &kp S       &kp D          &kp F      &kp G      &kp DOWN               &kp PG_DN  &kp H     &kp J      &kp K          &kp L     &kp SEMI   &kp SQT
    &none      &kp Z       &kp X       &kp C          &kp V      &kp B      &kp UP                 &kp PG_UP  &kp N     &kp M      &kp COMMA      &kp DOT   &kp FSLH   &none
    &none      &kp LCTRL   &kp LSHFT   &lt FN_L DEL   &kp ENTER  &kp LALT   &kp RIGHT              &kp HOME   &kp EQUAL &kp SPACE  &lt FN_L BSPC  &kp RALT  &kp RGUI  &none
            >;
        };

        fn_layer {
            bindings = <
    &none           &kp F1    &kp F2    &kp F3    &kp F4      &kp F5     &kp INS                &none     &kp F6    &kp F7     &kp F8    &kp F9     &kp F10  &kp F11
    &none           &none     &none     &none     &none       &none      &none                  &none     &none      &none     &kp PG_UP  &none    &none     &kp F12
    &none           &none     &none     &none     &none       &none      &none                  &none     &none      &kp HOME  &kp PG_DN  &kp END  &none     &none
    &kp PAUSE_BREAK &none     &none     &none     &none       &kp K_APP  &none                  &trans    &kp K_APP  &none     &none      &none    &none     &none
    &none           &none     &none     &none     &mo HW_L    &none      &none                  &trans    &none      &mo HW_L  &none      &none    &none     &none
            >;
        };

        hw_layer {
            bindings = <
    &none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &bt BT_CLR         &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &none
    &bootloader  &trans        &trans        &trans        &trans  &out OUT_TOG  &none        &none   &out OUT_TOG  &trans  &trans  &trans  &trans  &bootloader
    &sys_reset   &trans        &trans        &trans        &trans  &trans  &trans             &trans        &trans  &trans  &trans  &trans  &trans  &sys_reset
    &kp ESC      &trans        &trans        &trans        &trans  &trans  &trans             &trans        &trans  &trans  &trans  &trans  &trans  &trans
    &kp ESC      &trans        &trans        &trans        &trans  &trans  &trans             &trans        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
